{
  "schema_version": 1,
  "terms": [
    {
      "zh": "独立 oracle",
      "en": "independent oracle",
      "definition": "不由被测实现计算得出的期望结果。"
    },
    {
      "zh": "命题",
      "en": "proposition",
      "definition": "具有确定真假值、需要证明或反驳的陈述。"
    },
    {
      "zh": "必要条件",
      "en": "necessary condition",
      "definition": "结论成立时必须满足的条件。"
    },
    {
      "zh": "充分条件",
      "en": "sufficient condition",
      "definition": "一旦满足即可推出结论的条件。"
    },
    {
      "zh": "反例",
      "en": "counterexample",
      "definition": "满足命题假设但使结论失败的合法对象。"
    },
    {
      "zh": "量纲",
      "en": "dimension",
      "definition": "数量所属的物理或金融单位类别，用于判断运算是否有意义。"
    },
    {
      "zh": "度量空间",
      "en": "metric space",
      "definition": "配备满足分离、对称和三角不等式之距离函数的集合。"
    },
    {
      "zh": "Cauchy 序列",
      "en": "Cauchy sequence",
      "definition": "尾部任意两项都能在给定度量下任意接近的序列。"
    },
    {
      "zh": "完备性",
      "en": "completeness",
      "definition": "空间中每个 Cauchy 序列都收敛到空间内一点的性质。"
    },
    {
      "zh": "一致收敛",
      "en": "uniform convergence",
      "definition": "同一索引阈值能同时控制定义域所有点误差的函数收敛。"
    },
    {
      "zh": "压缩映射",
      "en": "contraction mapping",
      "definition": "以严格小于 1 的统一因子缩短任意两点距离的映射。"
    },
    {
      "zh": "sigma 代数",
      "en": "sigma algebra",
      "definition": "包含全集并对补集和可数并封闭的事件集合族。"
    },
    {
      "zh": "测度",
      "en": "measure",
      "definition": "在 sigma 代数上取值并满足可数可加性的非负集合函数。"
    },
    {
      "zh": "可测函数",
      "en": "measurable function",
      "definition": "目标可测集的逆像始终属于定义域 sigma 代数的函数。"
    },
    {
      "zh": "简单函数",
      "en": "simple function",
      "definition": "只取有限多个值并可写为可测示性函数有限和的函数。"
    },
    {
      "zh": "Lebesgue 积分",
      "en": "Lebesgue integral",
      "definition": "由简单函数从下逼近构造并扩展到可积符号函数的积分。"
    },
    {
      "zh": "几乎处处",
      "en": "almost everywhere",
      "definition": "除一个零测集外性质均成立。"
    },
    {
      "zh": "Lp 空间",
      "en": "Lp space",
      "definition": "p 次绝对可积可测函数按几乎处处相等取等价类得到的完备范数空间。"
    },
    {
      "zh": "本质上确界",
      "en": "essential supremum",
      "definition": "允许忽略零测集后函数仍满足的最小几乎处处上界。"
    },
    {
      "zh": "Hölder 不等式",
      "en": "Holder inequality",
      "definition": "用一对共轭 Lp 范数控制函数乘积积分的不等式。"
    },
    {
      "zh": "Minkowski 不等式",
      "en": "Minkowski inequality",
      "definition": "保证 Lp 范数满足三角不等式的积分不等式。"
    },
    {
      "zh": "Tonelli 定理",
      "en": "Tonelli theorem",
      "definition": "允许非负可测函数交换乘积空间积分次序且共同值可以为无穷的定理。"
    },
    {
      "zh": "Fubini 定理",
      "en": "Fubini theorem",
      "definition": "在绝对可积条件下保证两种迭代积分与乘积空间积分相等的定理。"
    },
    {
      "zh": "乘积测度",
      "en": "product measure",
      "definition": "在可测矩形上取两个测度乘积并扩张到乘积 sigma 代数的测度。"
    },
    {
      "zh": "多元可微",
      "en": "multivariable differentiability",
      "definition": "函数增量可由一个统一线性映射逼近且余项相对输入增量范数消失。"
    },
    {
      "zh": "梯度",
      "en": "gradient",
      "definition": "表示标量函数一阶线性近似的偏导数组成的向量。"
    },
    {
      "zh": "Jacobian",
      "en": "Jacobian",
      "definition": "表示向量值函数一阶线性近似并按约定排列输入输出偏导的矩阵。"
    },
    {
      "zh": "Hessian",
      "en": "Hessian",
      "definition": "标量函数二阶偏导组成并描述局部曲率的方阵。"
    },
    {
      "zh": "矩阵微分",
      "en": "matrix differential",
      "definition": "通过线性微分与形状账本推导标量、向量和矩阵导数的记法。"
    },
    {"zh": "正交投影", "en": "orthogonal projection", "definition": "将向量映射到子空间且使残差位于该子空间正交补的线性映射。"},
    {"zh": "最小二乘", "en": "least squares", "definition": "通过最小化残差平方和估计参数的方法。"},
    {"zh": "谱分解", "en": "spectral decomposition", "definition": "将实对称矩阵写成正交特征向量与实特征值的分解。"},
    {"zh": "奇异值分解", "en": "singular value decomposition", "definition": "将任意矩阵分解为左右正交方向与非负奇异值。"},
    {"zh": "条件数", "en": "condition number", "definition": "衡量问题输出对输入相对扰动最坏敏感度的数值。"},
    {"zh": "概率空间", "en": "probability space", "definition": "由样本空间、事件 sigma 代数与总质量为一的概率测度组成的三元组。"},
    {"zh": "随机变量", "en": "random variable", "definition": "从概率空间到目标可测空间的可测映射。"},
    {"zh": "推前分布", "en": "pushforward distribution", "definition": "随机变量通过逆像把底层概率测度推到目标空间得到的概率测度。"},
    {"zh": "联合分布", "en": "joint distribution", "definition": "随机向量在乘积空间上的推前概率分布。"},
    {"zh": "边缘分布", "en": "marginal distribution", "definition": "从联合分布对其余坐标积分或求和得到的单坐标分布。"},
    {"zh": "重尾分布", "en": "heavy-tailed distribution", "definition": "尾部衰减较慢并可能使某些矩不存在的分布。"},
    {"zh": "条件期望", "en": "conditional expectation", "definition": "给定子 sigma 代数时保持其每个事件上积分的可测随机变量。"},
    {"zh": "塔式性质", "en": "tower property", "definition": "对嵌套信息集合依次条件化等于直接对较粗信息条件化的性质。"},
    {"zh": "独立性", "en": "independence", "definition": "相关事件的联合概率对所有可测集合均分解为边缘概率乘积。"},
    {"zh": "条件独立", "en": "conditional independence", "definition": "给定指定信息后联合条件分布分解为条件边缘分布乘积。"},
    {"zh": "概率核", "en": "probability kernel", "definition": "对状态可测、对事件为概率测度的条件分布映射。"},
    {"zh": "几乎处处收敛", "en": "almost sure convergence", "definition": "除零概率状态外逐点收敛。"},
    {"zh": "依概率收敛", "en": "convergence in probability", "definition": "偏差超过任意正阈值的概率趋于零。"},
    {"zh": "Lp 收敛", "en": "Lp convergence", "definition": "差的 p 次绝对矩趋于零。"},
    {"zh": "分布收敛", "en": "convergence in distribution", "definition": "分布函数在极限分布连续点处收敛。"},
    {"zh": "大数定律", "en": "law of large numbers", "definition": "在明确矩与依赖条件下样本平均趋近总体均值的定理。"},
    {"zh": "中心极限定理", "en": "central limit theorem", "definition": "在明确正则条件下标准化和趋近正态分布的定理。"},
    {"zh": "集中不等式", "en": "concentration inequality", "definition": "有限样本下控制随机量偏离中心概率的非渐近上界。"},
    {"zh": "估计量", "en": "estimator", "definition": "把样本映射为参数估计、因而在重复抽样下本身是随机变量的规则。"},
    {"zh": "一致性", "en": "consistency", "definition": "样本量增大时估计量依概率收敛到目标参数的性质。"},
    {"zh": "渐近分布", "en": "asymptotic distribution", "definition": "估计误差经过适当中心化与缩放后得到的极限分布。"},
    {"zh": "异方差稳健标准误", "en": "heteroskedasticity-robust standard error", "definition": "不要求条件误差方差恒定、用三明治协方差估计得到的标准误。"},
    {"zh": "族错误率", "en": "family-wise error rate", "definition": "一族真零假设中至少错误拒绝一个的概率。"},
    {"zh": "错误发现率", "en": "false discovery rate", "definition": "拒绝集合中错误发现比例期望值的控制目标。"},
    {"zh": "随机过程", "en": "stochastic process", "definition": "同一概率空间上由时间或其他索引参数化的随机变量族。"},
    {"zh": "滤过", "en": "filtration", "definition": "随索引递增、表示可用信息增长的 sigma 代数族。"},
    {"zh": "Markov 性", "en": "Markov property", "definition": "给定当前状态后未来条件分布不再依赖更早历史的性质。"},
    {"zh": "鞅", "en": "martingale", "definition": "给定当前信息时下一时点条件期望等于当前值的可积适应过程。"},
    {"zh": "Poisson 过程", "en": "Poisson process", "definition": "具有独立平稳增量且计数增量服从 Poisson 分布的计数过程。"},
    {"zh": "Brownian 运动", "en": "Brownian motion", "definition": "从零开始、具有连续路径及独立平稳高斯增量的过程。"},
    {"zh": "二次变差", "en": "quadratic variation", "definition": "沿越来越细分割对路径增量平方求和得到的极限对象。"},
    {
      "zh": "样本外",
      "en": "out of sample",
      "definition": "未参与模型选择、拟合或阈值确定的数据区间。"
    }
  ]
}
