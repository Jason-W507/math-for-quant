{
  "schema_version": 1,
  "terms": [
    {
      "zh": "独立 oracle",
      "en": "independent oracle",
      "definition": "不由被测实现计算得出的期望结果。"
    },
    {
      "zh": "命题",
      "en": "proposition",
      "definition": "具有确定真假值、需要证明或反驳的陈述。"
    },
    {
      "zh": "必要条件",
      "en": "necessary condition",
      "definition": "结论成立时必须满足的条件。"
    },
    {
      "zh": "充分条件",
      "en": "sufficient condition",
      "definition": "一旦满足即可推出结论的条件。"
    },
    {
      "zh": "反例",
      "en": "counterexample",
      "definition": "满足命题假设但使结论失败的合法对象。"
    },
    {
      "zh": "量纲",
      "en": "dimension",
      "definition": "数量所属的物理或金融单位类别，用于判断运算是否有意义。"
    },
    {
      "zh": "度量空间",
      "en": "metric space",
      "definition": "配备满足分离、对称和三角不等式之距离函数的集合。"
    },
    {
      "zh": "Cauchy 序列",
      "en": "Cauchy sequence",
      "definition": "尾部任意两项都能在给定度量下任意接近的序列。"
    },
    {
      "zh": "完备性",
      "en": "completeness",
      "definition": "空间中每个 Cauchy 序列都收敛到空间内一点的性质。"
    },
    {
      "zh": "一致收敛",
      "en": "uniform convergence",
      "definition": "同一索引阈值能同时控制定义域所有点误差的函数收敛。"
    },
    {
      "zh": "压缩映射",
      "en": "contraction mapping",
      "definition": "以严格小于 1 的统一因子缩短任意两点距离的映射。"
    },
    {
      "zh": "样本外",
      "en": "out of sample",
      "definition": "未参与模型选择、拟合或阈值确定的数据区间。"
    }
  ]
}
