{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/licenses.schema.json",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "paths", "license_id", "license_file", "required_marker", "scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "license_id": {"type": "string", "minLength": 1},
          "license_file": {"type": "string", "minLength": 1},
          "required_marker": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
