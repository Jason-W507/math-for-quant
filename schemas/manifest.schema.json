{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "prerequisite_semantics", "question_levels", "registries", "volumes", "supplements", "units", "reading_routes", "reader_bridges", "tracks"],
  "properties": {
    "schema_version": {"const": 1},
    "prerequisite_semantics": {"const": "direct"},
    "question_levels": {
      "type": "array",
      "prefixItems": [
        {"const": "oral"}, {"const": "derivation"},
        {"const": "computation"}, {"const": "research"}
      ],
      "items": false
    },
    "registries": {
      "type": "object",
      "required": ["notation", "glossary"],
      "properties": {
        "notation": {"type": "string", "minLength": 1},
        "glossary": {"type": "string", "minLength": 1}
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "pdf"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "pdf": {"type": "string", "minLength": 1}
        }
      }
    },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "parent_volumes", "source", "pdf"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "parent_volumes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source": {"type": "string", "minLength": 1},
          "pdf": {"type": "string", "minLength": 1}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "volume", "state", "published", "prerequisites", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "volume": {"type": "string", "minLength": 1},
          "state": {"enum": ["draft", "accepted", "deprecated"]},
          "published": {"type": "boolean"},
          "internal": {"type": "boolean"},
          "capstone": {"type": "boolean"},
          "track": {"type": "string", "minLength": 1},
          "track_stage": {"enum": ["model-math", "estimation-numerics", "oos-frictions-capstone"]},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"required": ["track"]},
            "then": {
              "required": ["track_stage"],
              "properties": {
                "evidence": {
                  "required": ["dual_track_data", "dual_implementation", "teaching_notebook", "route_report", "shared_solutions"],
                  "properties": {
                    "dual_track_data": {
                      "type": "object",
                      "required": ["oracle_fixture", "real_data_snapshot", "license", "sha256", "time_protocol", "real_data_oracle"],
                      "properties": {
                        "oracle_fixture": {"type": "string", "minLength": 1},
                        "real_data_snapshot": {"type": "string", "minLength": 1},
                        "license": {"type": "string", "minLength": 1},
                        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "time_protocol": {"type": "string", "minLength": 1},
                        "real_data_oracle": {
                          "type": "object",
                          "required": ["source", "oracle", "command"],
                          "properties": {
                            "source": {"type": "string", "minLength": 1},
                            "oracle": {"type": "string", "minLength": 1},
                            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                          }
                        }
                      }
                    },
                    "dual_implementation": {
                      "type": "object",
                      "required": ["transparent", "library"],
                      "properties": {
                        "transparent": {"type": "string", "minLength": 1},
                        "library": {"type": "string", "minLength": 1}
                      }
                    },
                    "teaching_notebook": {"type": "string", "minLength": 1},
                    "route_report": {
                      "type": "object",
                      "required": ["source", "command", "expected"],
                      "properties": {
                        "source": {"type": "string", "minLength": 1},
                        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                        "expected": {"type": "string", "minLength": 1}
                      }
                    },
                    "shared_solutions": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "reading_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "units"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "units": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "reader_bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "for_routes", "before_unit", "review_units"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "for_routes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "before_unit": {"type": "string", "minLength": 1},
          "review_units": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "bridge_prerequisites", "planned_units"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "bridge_prerequisites": {"type": "array", "items": {"type": "string"}},
          "planned_units": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
