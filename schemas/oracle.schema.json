{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/oracle.schema.json",
  "type": "object",
  "required": ["expected", "absolute_tolerance", "provenance"],
  "properties": {
    "expected": {},
    "absolute_tolerance": {"type": "number", "minimum": 0},
    "provenance": {"type": "string", "minLength": 1},
    "published_markers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "fixture": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
