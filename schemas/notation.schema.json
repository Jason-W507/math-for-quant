{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/notation.schema.json",
  "type": "object",
  "required": ["schema_version", "symbols"],
  "properties": {
    "schema_version": {"const": 1},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "meaning", "domain", "first_unit"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "first_unit": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
