{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "version", "git_commit", "source_date_epoch",
    "generated_at_utc", "accepted_units", "published_units",
    "route_diagnostics", "capstones", "license_policy",
    "template_provenance", "assets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_date_epoch": {"type": "integer", "minimum": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "accepted_units": {"type": "integer", "minimum": 1},
    "published_units": {"type": "integer", "minimum": 1},
    "route_diagnostics": {"type": "integer", "minimum": 1},
    "capstones": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "license_policy": {"type": "string", "minLength": 1},
    "template_provenance": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "license_id", "license_files", "version", "source", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "license_id": {"type": "string", "minLength": 1},
          "license_files": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ,"provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "selection", "missing_values", "transformations"],
            "properties": {
              "schema": {"type": "string", "minLength": 1},
              "selection": {"type": "string", "minLength": 1},
              "missing_values": {"type": "string", "minLength": 1},
              "transformations": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "frozen-public-data"}}},
            "then": {"required": ["provenance"]}
          }
        ]
      }
    }
  }
}
