{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/data-assets.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "paths", "kind", "source", "version", "license_id",
          "license_file", "required_marker"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "paths": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^data/"}
          },
          "kind": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "license_id": {"type": "string", "minLength": 1},
          "license_file": {"type": "string", "minLength": 1},
          "required_marker": {"type": "string", "minLength": 1}
          ,"schema": {"type": "string", "minLength": 1}
          ,"selection": {"type": "string", "minLength": 1}
          ,"missing_values": {"type": "string", "minLength": 1}
          ,"transformations": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "frozen-public-data"}}},
            "then": {
              "required": ["schema", "selection", "missing_values", "transformations"]
            }
          }
        ]
      }
    }
  }
}
