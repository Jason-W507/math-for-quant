{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jason-W507/math-for-quant/schemas/glossary.schema.json",
  "type": "object",
  "required": ["schema_version", "terms"],
  "properties": {
    "schema_version": {"const": 1},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zh", "en", "definition"],
        "properties": {
          "zh": {"type": "string", "minLength": 1},
          "en": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
